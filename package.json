{
  "name": "dsh-approve-for-me",
  "version": "0.4.0",
  "description": "Codex-aligned Auto-review and Approve for me mode for DeepSeek Harness",
  "type": "module",
  "main": "lib/dsh-approve-for-me.js",
  "types": "lib/types/dsh-approve-for-me.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown && node scripts/normalize-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./lib/types/dsh-approve-for-me.d.ts",
      "default": "./lib/dsh-approve-for-me.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-auto-review.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-auto-review#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-auto-review/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "auto-review",
    "approval",
    "api-key",
    "oauth",
    "dsh-plugin"
  ],
  "author": "aa2246740",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-user-approval": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-session-projection": ">=0.1.7-rc.1 <0.1.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/dsh-user-approval": ">=0.1.7-rc.1 <0.1.8",
    "@deepseek-ai/schemastery": "~3.18.4",
